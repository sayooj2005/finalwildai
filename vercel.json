{
    "framework": null,
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://finalwildai-backend.onrender.com/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://finalwildai-backend.onrender.com/uploads/:path*"
        },
        {
            "source": "/video_feed",
            "destination": "https://finalwildai-backend.onrender.com/video_feed"
        },
        {
            "source": "/sos",
            "destination": "/emergency-sos.html"
        },
        {
            "source": "/portal",
            "destination": "/user-portal.html"
        },
        {
            "source": "/admin",
            "destination": "/admin-portal.html"
        }
    ]
}