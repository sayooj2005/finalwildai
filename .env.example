# WILDAI Environment Configuration
# Copy this file to .env and configure specific keys as needed.

# Server & Security Settings
ADMIN_USER=admin
ADMIN_PASS=wildai_secure_2026
ALLOWED_ORIGINS=*
PORT=8083

# Model Configuration
MODEL_PATH=yolo11n.pt
